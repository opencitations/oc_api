@@with index
@@join ?citing_br ?citing_br
@@values ?citing_br
PREFIX cito: <http://purl.org/spar/cito/>
SELECT DISTINCT ?citing_br ?cited_br WHERE {
  ?citation cito:hasCitingEntity ?citing_br ;
      cito:hasCitedEntity ?cited_br .
}
LIMIT 200000
