GROUP BY ?cited_br
@@join ?oci ?oci type=left
@@values ?cited_br batch_size=10000 workers=8
PREFIX datacite: <http://purl.org/spar/datacite/>
PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>
PREFIX frbr: <http://purl.org/vocab/frbr/core#>
PREFIX fabio: <http://purl.org/spar/fabio/>
PREFIX pro: <http://purl.org/spar/pro/>
SELECT DISTINCT ?oci ("yes" AS ?same_journal) WHERE {
  {
    SELECT ?citing_br ?journal WHERE {
      [[doi]]
      ?citing_br a fabio:JournalArticle ;
          frbr:partOf+ ?journal .
      ?journal a fabio:Journal .
    }
  }
  ?cited_br a fabio:JournalArticle ;
      frbr:partOf+ ?journal .
  BIND(CONCAT(STRAFTER(STR(?citing_br), "https://w3id.org/oc/meta/br/"), "-", STRAFTER(STR(?cited_br), "https://w3id.org/oc/meta/br/")) AS ?oci)
}
@@join ?oci ?oci type=left
@@values ?cited_br batch_size=10000 workers=8
PREFIX datacite: <http://purl.org/spar/datacite/>
PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>
PREFIX frbr: <http://purl.org/vocab/frbr/core#>
PREFIX fabio: <http://purl.org/spar/fabio/>
PREFIX pro: <http://purl.org/spar/pro/>
SELECT DISTINCT ?oci ("yes" AS ?same_author) WHERE {
  {
    SELECT ?citing_br ?author WHERE {
      [[doi]]
      ?citing_br pro:isDocumentContextFor ?citing_role .
      ?citing_role pro:withRole pro:author ;
          pro:isHeldBy ?author .
    }
  }
  ?cited_role pro:isHeldBy ?author ;
      pro:withRole pro:author .
  ?cited_br pro:isDocumentContextFor ?cited_role .
  BIND(CONCAT(STRAFTER(STR(?citing_br), "https://w3id.org/oc/meta/br/"), "-", STRAFTER(STR(?cited_br), "https://w3id.org/oc/meta/br/")) AS ?oci)
}
