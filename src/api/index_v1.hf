PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>
PREFIX prism: <http://prismstandard.org/namespaces/basic/2.0/>
SELECT ?citing_br (GROUP_CONCAT(DISTINCT ?id; SEPARATOR=" __ ") AS ?citing_ids) (MIN(STR(?date)) AS ?citing_date) WHERE {
  ?citing_br datacite:hasIdentifier ?identifier .
  ?identifier datacite:usesIdentifierScheme ?scheme ;
      literal:hasLiteralValue ?value .
  BIND(CONCAT(STRAFTER(STR(?scheme), "http://purl.org/spar/datacite/"), ":", ?value) AS ?id)
  OPTIONAL { ?citing_br prism:publicationDate ?date }
}
GROUP BY ?citing_br
@@with meta
@@join ?cited_br ?cited_br
@@values ?cited_br
PREFIX datacite: <http://purl.org/spar/datacite/>
PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>
PREFIX prism: <http://prismstandard.org/namespaces/basic/2.0/>
SELECT ?cited_br (GROUP_CONCAT(DISTINCT ?id; SEPARATOR=" __ ") AS ?cited_ids) (MIN(STR(?date)) AS ?cited_date) WHERE {
  ?cited_br datacite:hasIdentifier ?identifier .
  ?identifier datacite:usesIdentifierScheme ?scheme ;
      literal:hasLiteralValue ?value .
  BIND(CONCAT(STRAFTER(STR(?scheme), "http://purl.org/spar/datacite/"), ":", ?value) AS ?id)
