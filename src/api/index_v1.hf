PREFIX datacite: <http://purl.org/spar/datacite/>
PREFIX literal: <http://www.essepuntato.it/2010/06/literalreification/>
PREFIX frbr: <http://purl.org/vocab/frbr/core#>
PREFIX fabio: <http://purl.org/spar/fabio/>
SELECT DISTINCT ?cited_br WHERE {
  [[doi]]
}
@@with index
@@join ?cited_br ?cited_br
@@values ?cited_br
PREFIX cito: <http://purl.org/spar/cito/>
SELECT ?oci ?citing_br ?cited_br WHERE {
  ?citation cito:hasCitedEntity ?cited_br ;
      cito:hasCitingEntity ?citing_br .
  BIND(STRAFTER(STR(?citation), "https://w3id.org/oc/index/ci/") AS ?oci)
}
LIMIT 200000
@@with meta
@@join ?citing_br ?citing_br
@@values ?citing_br batch_size=10000 workers=8
