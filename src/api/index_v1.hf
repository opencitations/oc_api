SELECT ?oci ?citing_br ?cited_br WHERE {
  ?citation cito:hasCitingEntity ?citing_br ;
      cito:hasCitedEntity ?cited_br .
  BIND(STRAFTER(STR(?citation), "https://w3id.org/oc/index/ci/") AS ?oci)
}
LIMIT 200000
