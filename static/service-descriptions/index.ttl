@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix ns1: <http://www.w3.org/ns/sparql-service-description#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix void: <http://rdfs.org/ns/void#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

[] a ns1:Service ;
    ns1:defaultDataset [ a void:Dataset,
                ns1:Dataset ;
            dcterms:description "OpenCitations Index data"@en ;
            dcterms:title "OpenCitations Index"@en ;
            void:sparqlEndpoint <https://sparql.opencitations.net/index> ;
            void:uriSpace "https://w3id.org/oc/index/" ;
            ns1:defaultGraph [ a ns1:Graph ;
                    void:classPartition [ void:class <http://purl.org/spar/cito/JournalSelfCitation> ;
                            void:entities 106690556 ],
                        [ void:class <http://purl.org/spar/cito/Citation> ;
                            void:entities 2315872191 ],
                        [ void:class <http://purl.org/spar/cito/AuthorSelfCitation> ;
                            void:entities 60230010 ] ;
                    void:classes 3 ;
                    void:distinctObjects 101077399 ;
                    void:distinctSubjects 2315872191 ;
                    void:properties 5 ;
                    void:propertyPartition [ void:property <http://purl.org/spar/cito/hasCitationCreationDate> ;
                            void:triples 2298554972 ],
                        [ void:property <http://purl.org/spar/cito/hasCitingEntity> ;
                            void:triples 2315872191 ],
                        [ void:property <http://purl.org/spar/cito/hasCitationTimeSpan> ;
                            void:triples 2038634405 ],
                        [ void:property <http://purl.org/spar/cito/hasCitedEntity> ;
                            void:triples 2315872191 ],
                        [ void:property rdf:type ;
                            void:triples 2482792757 ] ;
                    void:triples 11451726516 ] ] ;
    ns1:endpoint <https://sparql.opencitations.net/index> ;
    ns1:feature ns1:BasicFederatedQuery ;
    ns1:resultFormat <http://www.w3.org/ns/formats/SPARQL_Results_CSV>,
        <http://www.w3.org/ns/formats/SPARQL_Results_JSON>,
        <http://www.w3.org/ns/formats/SPARQL_Results_TSV>,
        <http://www.w3.org/ns/formats/SPARQL_Results_XML>,
        <http://www.w3.org/ns/formats/Turtle> ;
    ns1:supportedLanguage ns1:SPARQL11Query .
